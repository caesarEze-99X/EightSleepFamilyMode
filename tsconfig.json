
{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs", 
    "lib": ["esnext"],
    "allowJs": true,
    "jsx": "react-native",
    "rootDir": "./",
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "strict": true,
    "strictNullChecks": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "*": [
        "src/*",
        "./*"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "resolveJsonModule": true
  },
  "exclude": [
    "node_modules", "babel.config.js", "metro.config.js", "jest.config.js"
  ]
}
